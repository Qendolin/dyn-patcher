{
	"schemaVersion": 1,
	"id": "dynpatcher",
	"version": "${version}",
	"name": "Dynamic Patcher",
	"description": "Dynamically compile and load Mixin patches from source at runtime.",
	"authors": [
		"Qendolin"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/dynpatcher/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.qendolin.dynpatcher.DynamicPatcher"
		]
	},
	"mixins": [
		"dynpatcher.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.1",
		"java": ">=25"
	}
}